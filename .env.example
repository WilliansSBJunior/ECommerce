# URL do banco de dados. Padrao: SQLite local (zero configuracao).
# Para usar Postgres depois: postgresql+psycopg2://usuario:senha@host:5432/nome_do_banco
DATABASE_URL=sqlite:///data/ecommerce.db

# Site do Mercado Livre para buscas na API (MLB = Brasil)
ML_SITE_ID=MLB

# Credenciais do app no DevCenter do ML (obrigatorio para collect/research).
# Passo a passo: docs/estudo_viabilidade_extrator.md, secao "Token da API do ML".
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=https://localhost/callback
# Gerado pelo comando `ml-auth --code ...`; renova o token sozinho.
ML_REFRESH_TOKEN=

# Imposto sobre a venda (0.06 = 6%, ex: Simples Nacional) e custo de embalagem padrao
DEFAULT_TAX_RATE=0.06
DEFAULT_PACKAGING_COST=1.50

# Perfil do navegador logado usado pelo extrator (scrape)
BROWSER_PROFILE_DIR=data/browser_profile
